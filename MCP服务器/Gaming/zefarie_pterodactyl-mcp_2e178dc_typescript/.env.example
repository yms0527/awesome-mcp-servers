# Pterodactyl Panel URL (required)
PTERODACTYL_URL=https://panel.example.com

# Application API Key (required) — used for /api/application/* admin endpoints
# Generate in: Admin Panel > Application API > Create API Key
# Starts with ptla_
PTERODACTYL_APP_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Client API Key (optional) — used for /api/client/* endpoints (power, files, console, backups)
# Generate in: Account > API Credentials > Create
# Starts with ptlc_
# Without this key, only admin/read tools are available. Power control, file management,
# console commands, backups, schedules, and subuser tools require a client key.
# PTERODACTYL_CLIENT_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allow HTTP connections (development only, default: false)
# PTERODACTYL_ALLOW_INSECURE=true
