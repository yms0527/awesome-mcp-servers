{
  "name": "aider-mcp-server",
  "version": "0.1.0",
  "description": "MCP WebSocket server for Aider",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "mcp": "tsx watch src/mcp-server.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
