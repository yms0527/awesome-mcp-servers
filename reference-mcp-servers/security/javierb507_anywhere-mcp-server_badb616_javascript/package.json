  "description": "Unofficial MCP server for LevelBlue USM Anywhere and AlienVault OTX API integration - Not affiliated with LevelBlue",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "clean": "rm -rf dist",
    "test": "tsc && node dist/test/validation.test.js",
    "validate": "npm run test",
    "lint": "echo 'Linting with TypeScript compiler...' && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
