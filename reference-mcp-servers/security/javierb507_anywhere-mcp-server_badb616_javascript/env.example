# AlienVault/AT&T Cybersecurity API Configuration

# USM Anywhere API v2.0 (OAuth 2.0) - Recommended
# Get your OAuth credentials from your USM Anywhere instance
ALIENVAULT_CLIENT_ID=your_client_id_here
ALIENVAULT_CLIENT_SECRET=your_client_secret_here
ALIENVAULT_SUBDOMAIN=your_subdomain_here

# Legacy AlienVault OTX API (API Key) - For backward compatibility
# Get your API key from: https://otx.alienvault.com/api
ALIENVAULT_OTX_API_KEY=your_otx_api_key_here

# Optional: Set log level (debug, info, warn, error)
LOG_LEVEL=info

# Note: You can use either USM Anywhere API v2.0 OR legacy OTX API, or both.
# If both are configured, the server will support tools from both APIs. 