# OpenAI API key - Required for examples using LLMs
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration
MCP_SERVER_PATH=simple_server.py

# LLM Configuration
LLM_MODEL=gpt-3.5-turbo
# LLM_MODEL=gpt-4  # Uncomment to use GPT-4 (requires proper access)
LLM_TEMPERATURE=0

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO  