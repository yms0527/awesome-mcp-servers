{
  "name": "@zefarie/pterodactyl-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes Pterodactyl Panel API to LLMs via the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pterodactyl-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "pterodactyl",
    "model-context-protocol",
    "game-server",
    "server-management",
    "llm",
    "ai",
    "claude",
    "minecraft"
  ],
  "author": "zefarie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zefarie/pterodactyl-mcp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agents": "^0.7.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  }
}
