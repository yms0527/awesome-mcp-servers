# Copy this to .env and fill in your actual values.
# DO NOT commit your actual .env file to version control.

# Required: SiliconFlow API Key(s), comma-separated if multiple
SILICONFLOW_API_KEYS=sk-yourkey1,sk-anotherkey2_if_any

# Optional: Override default generation parameters for the tool
# DEFAULT_MODEL_ID=Pro/black-forest-labs/FLUX.1-schnell
# DEFAULT_ASPECT_RATIO="16:9"
# DEFAULT_NUM_INFERENCE_STEPS=25
# DEFAULT_GUIDANCE_SCALE=7.0

# Optional: Override default HTTP server settings
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080
# MCP_LOG_LEVEL=INFO # Supported: DEBUG, INFO, WARNING, ERROR, CRITICAL
